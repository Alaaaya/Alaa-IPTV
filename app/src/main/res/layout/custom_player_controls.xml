<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:gravity="bottom"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_cinematic_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_player_live_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="LIVE"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exo_channel_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/exo_stream_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B8C0CC"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:textColor="#EAF0F7"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- يجب أن يكون exo_progress من نوع TimeBar. استخدام SeekBar هنا يسبب
             ClassCastException داخل Media3 عند إنشاء PlayerView. -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:played_color="@color/accent_blue"
            app:scrubber_color="@color/accent_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/exo_rew"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_chip"
                android:contentDescription="إرجاع عشر ثوانٍ"
                android:padding="12dp" />

            <ImageButton
                android:id="@+id/exo_play_pause"
                android:layout_width="62dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_player_control_chip"
                android:contentDescription="تشغيل أو إيقاف"
                android:padding="14dp" />

            <ImageButton
                android:id="@+id/exo_ffwd"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_player_control_chip"
                android:contentDescription="تقديم عشر ثوانٍ"
                android:padding="12dp" />

            <TextView
                android:id="@+id/exo_channel_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="▲▼ تغيير القناة   •   MENU الصوت والجودة"
                android:textColor="#B8C0CC"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
