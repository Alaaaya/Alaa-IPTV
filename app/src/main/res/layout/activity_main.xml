<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/dark_background"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ================= LEFT PANEL ================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== TOP TABS ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/glassmorphism_background"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/liveTvTab"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/live_tv"
                android:nextFocusRight="@id/moviesTab"
                android:nextFocusDown="@id/categoriesRecyclerView" />

            <Button
                android:id="@+id/moviesTab"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/movies"
                android:nextFocusLeft="@id/liveTvTab"
                android:nextFocusRight="@id/seriesTab"
                android:nextFocusDown="@id/categoriesRecyclerView" />

            <Button
                android:id="@+id/seriesTab"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/series"
                android:nextFocusLeft="@id/moviesTab"
                android:nextFocusDown="@id/categoriesRecyclerView" />
        </LinearLayout>

        <!-- ===== CATEGORIES ===== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoriesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:nextFocusUp="@id/liveTvTab"
            android:nextFocusDown="@id/channelsRecyclerView" />

        <!-- ===== CHANNELS LIST ===== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:nextFocusUp="@id/categoriesRecyclerView" />

    </LinearLayout>

    <!-- ================= RIGHT PREVIEW PANEL ================= -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/glassmorphism_background"
            android:padding="20dp">

            <!-- PREVIEW IMAGE -->
            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="@color/card_background"
                android:contentDescription="@string/app_name" />

            <!-- TITLE -->
            <TextView
                android:id="@+id/previewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- INFO -->
            <TextView
                android:id="@+id/previewInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- ACTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/playButton"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/play"
                    android:nextFocusRight="@id/favoriteButton" />

                <Button
                    android:id="@+id/favoriteButton"
                    style="@style/PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤"
                    android:nextFocusLeft="@id/playButton" />
            </LinearLayout>

        </LinearLayout>

        <!-- LOADING -->
        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_blue"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
