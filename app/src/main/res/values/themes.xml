<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.AlaaIPTV" parent="Theme.Leanback">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.AlaaIPTV" parent="Base.Theme.AlaaIPTV">
        <!-- Glassmorphism design elements -->
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
    
    <!-- Card Style with Glassmorphism -->
    <style name="GlassCard">
        <item name="android:background">@color/glass_background</item>
        <item name="android:elevation">8dp</item>
    </style>
    
    <!-- Text Styles -->
    <style name="TextAppearance.Title" parent="TextAppearance.Leanback.Title">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.Subtitle" parent="TextAppearance.Leanback.Header">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="TextAppearance.Body" parent="TextAppearance.Leanback.Row.Header">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <!-- Button Style -->
    <style name="GlassButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/glass_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:elevation">4dp</item>
    </style>
</resources>
