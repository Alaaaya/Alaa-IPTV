<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AlaaIPTV" parent="Theme.Leanback">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_dark_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/background_darker</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor" tools:targetApi="l">@color/background_darker</item>
        
        <!-- Focus highlight -->
        <item name="android:colorControlHighlight">@color/focus_background</item>
    </style>

    <!-- Player theme with immersive mode -->
    <style name="Theme.AlaaIPTV.Player" parent="Theme.AlaaIPTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- EditText style with glassmorphism -->
    <style name="Widget.AlaaIPTV.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:background">@drawable/bg_glass_input</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Button style with glassmorphism -->
    <style name="Widget.AlaaIPTV.Button" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Card style with glassmorphism -->
    <style name="Widget.AlaaIPTV.Card">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.AlaaIPTV.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AlaaIPTV.Subtitle" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.AlaaIPTV.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
