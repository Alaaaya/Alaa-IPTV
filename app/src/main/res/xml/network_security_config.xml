<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for IPTV servers that may use HTTP -->
    <!-- In production, consider restricting this to specific domains -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Example: To restrict to specific domains only, uncomment and configure:
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">example.com</domain>
        <domain includeSubdomains="true">yourserver.com</domain>
    </domain-config>
    -->
</network-security-config>
