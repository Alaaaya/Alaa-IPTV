<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- بعض مزودي IPTV يعملون عبر HTTP فقط؛ التطبيق لا يسمح بعناوين محلية ضمن سياسة الروابط. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
