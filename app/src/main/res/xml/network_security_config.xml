<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All remote IPTV, provisioning, and update traffic must use HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
