<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#44FF1744" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#FFFF5270" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFE91E45" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFE11D3E" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
